package Rest;

import static io.restassured.RestAssured.*;

import org.testng.annotations.Test;

import com.aventstack.extentreports.ExtentTest;

public class APITest {

    @Test
    public void executeAPI() throws Exception {

        ExtentTest test =
                ExtentManager.extent.createTest("DummyJSON API Test");

        int rows = ExcelUtility.getRowCount();

        for (int i = 1; i <= rows; i++) {

            String method = ExcelUtility.getCellData(i, 2).trim();
            String url = ExcelUtility.getCellData(i, 3).trim();

            int expectedStatus =
                    Integer.parseInt(ExcelUtility.getCellData(i, 4).trim());

            System.out.println("=================================");
            System.out.println("Method : " + method);
            System.out.println("URL : " + url);
            System.out.println("Expected Status : " + expectedStatus);
            System.out.println("=================================");

            if (method.equalsIgnoreCase("GET")) {

                given()

                .when()
                .get(url)

                .then()
                .statusCode(expectedStatus)
                .log().all();

                test.pass("GET API Passed : " + url);
            }

            else if (method.equalsIgnoreCase("POST")) {

                String body = "{}";

                if (url.contains("/users/add")) {

                    body = "{"
                            + "\"firstName\":\"Gautam\","
                            + "\"lastName\":\"Kumar\","
                            + "\"age\":23"
                            + "}";
                }

                else if (url.contains("/products/add")) {

                    body = "{"
                            + "\"title\":\"BMW Pencil\""
                            + "}";
                }

                else if (url.contains("/auth/login")) {

                    body = "{"
                            + "\"username\":\"emilys\","
                            + "\"password\":\"emilyspass\""
                            + "}";
                }

                given()
                .contentType("application/json")
                .body(body)

                .when()
                .post(url)

                .then()
                .statusCode(expectedStatus)
                .log().all();

                test.pass("POST API Passed : " + url);
            }

            else if (method.equalsIgnoreCase("PUT")) {

                String body =
                        "{"
                        + "\"title\":\"Updated Product\""
                        + "}";

                given()
                .contentType("application/json")
                .body(body)

                .when()
                .put(url)

                .then()
                .statusCode(expectedStatus)
                .log().all();

                test.pass("PUT API Passed : " + url);
            }

            else if (method.equalsIgnoreCase("DELETE")) {

                given()

                .when()
                .delete(url)

                .then()
                .statusCode(expectedStatus)
                .log().all();

                test.pass("DELETE API Passed : " + url);
            }
        }

        ExtentManager.extent.flush();
    }
}