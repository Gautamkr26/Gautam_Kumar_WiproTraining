package Rest;

import static io.restassured.RestAssured.*;

import org.testng.annotations.Test;

public class APITest {

    @Test
    public void executeAPI() throws Exception {

        int rows = ExcelUtility.getRowCount();

        for (int i = 1; i <= rows; i++) {

            String method = ExcelUtility.getCellData(i, 2).trim();
            String url = ExcelUtility.getCellData(i, 3).trim();

            System.out.println("\n=================================");
            System.out.println("Method : " + method);
            System.out.println("URL    : " + url);
            System.out.println("=================================");

            if (method.equalsIgnoreCase("GET")) {

                given()

                .when()
                .get(url)

                .then()
                .statusCode(200)
                .log().all();
            }

            else if (method.equalsIgnoreCase("POST")) {

                String body = """
                {
                  "firstName":"Gautam",
                  "lastName":"Kumar",
                  "age":23
                }
                """;

                given()
                .contentType("application/json")
                .body(body)

                .when()
                .post(url)

                .then()
                .statusCode(201)
                .log().all();
            }

            else if (method.equalsIgnoreCase("PUT")) {

                String body = """
                {
                  "firstName":"Updated Gautam"
                }
                """;

                given()
                .contentType("application/json")
                .body(body)

                .when()
                .put(url)

                .then()
                .statusCode(200)
                .log().all();
            }

            else if (method.equalsIgnoreCase("DELETE")) {

                given()

                .when()
                .delete(url)

                .then()
                .statusCode(200)
                .log().all();
            }

            else {
                System.out.println("Invalid Method Found : " + method);
            }
        }
    }
}